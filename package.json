{
  "name": "student-assignment-tracker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "render-build": "npm install && npm install --prefix server && npm install --prefix client --include=dev && npm run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.1.2",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  }
}
